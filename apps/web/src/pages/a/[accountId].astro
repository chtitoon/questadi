---
import Base from '../../layouts/Base.astro';
import Author from '../../components/Author.astro';

import { env } from 'cloudflare:workers';

const { accountId } = Astro.params;
const api = (env as unknown as { API: Fetcher }).API;

type AuthorData = {
  accountId: string;
  displayName: string;
  quotes: Array<{ id: string; text: string; captured_at: string }>;
};

let data: AuthorData | null = null;
let errorCode: string | null = null;

try {
  const res = await api.fetch(new Request(`https://api/quotes?author=${accountId}`));
  if (res.ok) {
    data = await res.json();
  } else {
    const body = await res.json().catch(() => ({}));
    errorCode = body.code ?? (res.status === 404 ? 'NOT_FOUND' : 'INTERNAL_ERROR');
  }
} catch {
  errorCode = 'INTERNAL_ERROR';
}
---
<Base title={data ? `${data.displayName} — Questadi` : 'Questadi'}>
  <Author data={data} errorCode={errorCode} />
</Base>
